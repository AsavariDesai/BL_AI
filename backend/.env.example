# Copy this to backend/.env on the server and adjust as needed.

# Serves frontend/dist from the same FastAPI process, one port for everything.
SERVE_FRONTEND=1

# Uncomment to move the SQLite DB / uploads off the default backend/../data
# (e.g. onto a data drive that survives a VDI image refresh):
# BL_DATA_DIR=D:\bl-ai-data

# How many documents extract (OCR + field mapping) in parallel in the
# background. Default is CPU-aware (up to 4). Raise this on a server with
# more cores to speed up a large bulk upload (e.g. 400 House BLs at once):
# EXTRACT_WORKERS=8
